{
  "name": "reviveai",
  "version": "0.1.0",
  "description": "Autonomous Revenue Recovery Agent for small businesses",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node packages/server/dist/index.js",
    "build": "npm --workspaces run build",
    "dev": "node packages/server/dist/index.js",
    "dev:watch": "npm --workspace=packages/client run dev & npm --workspace=packages/server run dev",
    "db:seed": "npm --workspace=packages/server run db:seed",
    "db:migrate": "npm --workspace=packages/server run db:migrate",
    "test": "npx tsx packages/server/scripts/test-agent.ts",
    "lint": "npm run -r lint",
    "format": "npm run -r format"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "workspaces": [
    "packages/server",
    "packages/client"
  ]
}
