{
  "name": "reviveai",
  "version": "0.1.0",
  "description": "Autonomous Revenue Recovery Agent for small businesses",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "npm --workspace=packages/client run dev & npm --workspace=packages/server run dev",
    "build": "npm --workspaces run build",
    "start": "cd packages/server && node dist/index.js",
    "db:seed": "cd packages/server && npm run db:seed",
    "db:migrate": "cd packages/server && npm run db:migrate",
    "test": "npm run -r test",
    "lint": "npm run -r lint",
    "format": "npm run -r format"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "workspaces": [
    "packages/server",
    "packages/client"
  ]
}
