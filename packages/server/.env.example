# ReviveAI Server Environment Configuration
# Copy to .env and fill in actual values
# NEVER commit .env to git – use only locally or in GoDaddy secure config

# ===== ANTHROPIC CLAUDE API =====
# Anthropic API key for Claude requests
# Get from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-v7-YOUR_API_KEY_HERE

# Claude model to use (default: claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Mock mode: set to true to use mock provider (zero API calls, no cost)
# Set to false for real Claude API calls
# Default: true (development uses mock, no accidental API costs)
MOCK_MODE=true

# ===== DATABASE =====
# SQLite database file path (relative to server root)
DATABASE_URL=./data/reviveai.db

# ===== SERVER =====
# Port to listen on (GoDaddy will set this automatically)
# Local development: leave empty to use default 5000
PORT=5000

# Node environment
NODE_ENV=development

# ===== EMAIL (P1 FEATURE - NOT USED IN MVP) =====
# Email adapter mode: 'mock' or 'smtp'
# MVP: mock (logs to console)
# P1: smtp (real email delivery via GoDaddy domain)
EMAIL_ADAPTER=mock

# SMTP configuration (only needed when EMAIL_ADAPTER=smtp)
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=587
# SMTP_USER=support@yourdomain.com
# SMTP_PASSWORD=your_domain_email_password
# SMTP_FROM=support@yourdomain.com

# ===== LOGGING =====
# Log level: error, warn, info, debug, trace
LOG_LEVEL=info

# ===== CORS =====
# Allowed origins for CORS (comma-separated)
# Development: http://localhost:5173 (Vite client)
# IMPORTANT — Production: set this to your GoDaddy domain BEFORE deployment.
# Example: CORS_ORIGIN=https://reviveai.yourdomain.com
# If left as localhost in production, all browser requests will be blocked.
CORS_ORIGIN=http://localhost:5173,http://localhost:5000

# ===== BUSINESS CONFIG (DEFAULT FOR MVP) =====
# For single-business MVP, hardcoded business ID
DEFAULT_BUSINESS_ID=business-001
DEFAULT_BUSINESS_NAME=CoolCare AC Services

# ===== DEVELOPMENT =====
# Auto-reload on file changes (ts-node-dev)
TS_NODE_DEV_TRANSPILE_ONLY=true

# ===== FEATURE FLAGS =====
# Enable/disable features for testing
ENABLE_CSV_SEED_API=true
ENABLE_DEBUG_ENDPOINTS=false
