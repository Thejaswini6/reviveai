# ReviveAI Client Environment Configuration
# Vite frontend environment variables

# API endpoint (backend server URL)
# Development: http://localhost:5000 (Express dev server)
# Production: https://yourdomain.com (served by Express)
VITE_API_URL=http://localhost:5000

# Application name
VITE_APP_NAME=ReviveAI

# Application version
VITE_APP_VERSION=0.1.0

# Sentry/error tracking (optional, not used in MVP)
# VITE_SENTRY_DSN=

# Feature flags
VITE_ENABLE_ANALYTICS=false

# NOTE: 
# - Frontend should NEVER have access to ANTHROPIC_API_KEY or other backend secrets
# - All API calls go through backend proxy
# - Use VITE_ prefix for Vite to expose variables (only prefixed vars are available at runtime)
